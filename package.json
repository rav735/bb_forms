    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "playwright": "^1.56.1"
  }
}
